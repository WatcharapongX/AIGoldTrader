# ============================================================================
# AI Trading Platform — Environment Configuration (TEMPLATE)
# คัดลอกเป็น .env แล้วกรอกค่าจริง — ห้าม commit ไฟล์ .env (มี secret)
# ============================================================================

# --- Environment ---
APP_ENV=DEV                    # DEV | UAT | PROD
APP_NAME=ai-trading-platform
DEBUG=true

# --- Trading Safety (CRITICAL — ดู docs/01 G-01, G-03) ---
TRADING_MODE=PAPER             # BACKTEST | PAPER | SEMI_AUTO | LIVE (LIVE ต้องเปิดโดย ADMIN โดยเจตนา)
LIVE_AUTO_TRADING=false        # ห้ามเปลี่ยนเป็น true โดยไม่มีบันทึกอนุมัติ

# --- API / Security ---
SECRET_KEY=                    # REQUIRED: private random value, at least 32 bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MAX_KEYS=10000
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=           # Bounded IP/CIDR allow-list required when TRUST_PROXY=true
RATE_LIMIT_API_PER_MINUTE=120

# --- Native Windows PostgreSQL (Phase 1 needs no TimescaleDB extension) ---
# Set the complete URL, including port. Percent-encode special password characters.
# Example shape: postgresql+psycopg://<user>:<encoded-password>@<host>:<port>/<database>
DATABASE_URL=
# Optional Compose deployment / legacy connection fields (fill explicitly).
# Native DEV should use DATABASE_URL above.
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# TimescaleDB retention (วัน — null = เก็บตลอด)
TICKS_RETENTION_DAYS=30
M1_CANDLES_RETENTION_DAYS=365

# --- Redis (optional; no service required for Phase 1) ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- AI Provider (PHASE 6.2 — Safe default: fixture; NO committed secrets) ---
AI_PROVIDER_MODE=fixture       # fixture | external (explicit selection; never silent fallback)
AI_PROVIDER_TYPE=fixture       # fixture | openai_compatible
AI_PROVIDER_API_KEY=           # Required when AI_PROVIDER_MODE=external (keep empty here)
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MAX_CONCURRENT_PROVIDER_CALLS=6
AI_PROVIDER_QUEUE_TIMEOUT_SECONDS=15.0

# --- Broker (PHASE 10 — Demo เท่านั้นในระยะพัฒนา) ---
BROKER_TYPE=PAPER              # PAPER | MT5
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=                    # ต้องเป็น demo server (adapter ปฏิเสธ server ที่ไม่ใช่ demo)
BROKER_CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-key-for-fernet

# --- Market Data (PHASE 2) ---
MARKET_DATA_PROVIDER=simulated # simulated | mt5 (explicit; never silent fallback)
REPLAY_SPEED=10                # ตัวคูณความเร็วการเล่น replay
REPLAY_DATA_FILE=

# --- Logging / Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console

MARKET_STALE_SECONDS=5
MARKET_MAX_JUMP_RATIO=0.05
MARKET_MAX_SPREAD=10


# --- Phase 2.5 official MT5 read-only market data ---
# MT5_TERMINAL_PATH above must be an installed terminal64.exe already logged in.
# Phase 10 MT5_LOGIN/PASSWORD/SERVER are NOT used by this read-only adapter.
MT5_SYMBOL_XAUUSD=              # Exact broker symbol, confirmed in Market Watch
MT5_FEED_ID=                    # Public non-sensitive feed slug, <=16 lowercase letters/digits/underscores
MT5_EXPECTED_SERVER=            # Exact server from the authenticated terminal; server-side only
# MT5_EXPECTED_LOGIN=           # Optional integer account identity check; never sent to browser
MT5_ACCOUNT_MODE=DEMO           # Verified against official account metadata, never inferred from server name
MT5_POLL_SECONDS=1              # Shared IPC poll for all browsers, minimum 1 second
MT5_TIMEOUT_MS=10000
MARKET_ARCHIVE_REAL_TICKS=false # Keep disabled until an operator approves a retention policy
MT5_SERVER_TIMEZONE=UTC        # Explicit IANA broker timestamp policy; verify using provider evidence
MT5_FUTURE_TOLERANCE_SECONDS=2 # Bounded server clock skew; does not shift incoming timestamps

# Forex Factory official weekly USD calendar for STRAT05/06 only.
# Alternatives: xoomar (limited secondary/manual selection), fixture (explicit replay), unavailable.
NEWS_CALENDAR_PROVIDER=forex_factory
# NEWS_CONFIG accepts validated JSON; default provider polling is 60 seconds.

# Keyless weekly schedule/Forecast/Previous; Actual may be absent. No automatic fixture fallback.
NEWS_REAL_POLL_SECONDS=300
