# ============================================================================
# AI Trading Platform — Environment Configuration (TEMPLATE)
# คัดลอกเป็น .env แล้วกรอกค่าจริง — ห้าม commit ไฟล์ .env (มี secret)
# ============================================================================

# --- Environment ---
APP_ENV=DEV                    # DEV | UAT | PROD
APP_NAME=ai-trading-platform
DEBUG=true

# --- Trading Safety (CRITICAL — ดู docs/01 G-01, G-03) ---
TRADING_MODE=PAPER             # BACKTEST | PAPER | SEMI_AUTO | LIVE (LIVE ต้องเปิดโดย ADMIN โดยเจตนา)
LIVE_AUTO_TRADING=false        # ห้ามเปลี่ยนเป็น true โดยไม่มีบันทึกอนุมัติ

# --- API / Security ---
SECRET_KEY=                    # REQUIRED: private random value, at least 32 bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# --- Native Windows PostgreSQL (Phase 1 needs no TimescaleDB extension) ---
# Set the complete URL, including port. Percent-encode special password characters.
# Example shape: postgresql+psycopg://<user>:<encoded-password>@<host>:<port>/<database>
DATABASE_URL=
# Optional Compose deployment / legacy connection fields (fill explicitly).
# Native DEV should use DATABASE_URL above.
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# TimescaleDB retention (วัน — null = เก็บตลอด)
TICKS_RETENTION_DAYS=30
M1_CANDLES_RETENTION_DAYS=365

# --- Redis (optional; no service required for Phase 1) ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- AI Provider (เลือกตามที่ใช้ — ห้าม commit key จริง) ---
AI_PROVIDER=none               # none | openai | anthropic | ... (PHASE 6)
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# --- Broker (PHASE 10 — Demo เท่านั้นในระยะพัฒนา) ---
BROKER_TYPE=PAPER              # PAPER | MT5
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=                    # ต้องเป็น demo server (adapter ปฏิเสธ server ที่ไม่ใช่ demo)
BROKER_CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-key-for-fernet

# --- Market Data (PHASE 2) ---
MARKET_DATA_PROVIDER=replay    # replay | mt5
REPLAY_SPEED=10                # ตัวคูณความเร็วการเล่น replay
REPLAY_DATA_FILE=

# --- Logging / Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console
