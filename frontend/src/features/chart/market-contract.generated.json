{
  "schemas": {
    "Timeframe": {
      "enum": [
        "M1",
        "M3",
        "M5",
        "M15",
        "M30",
        "H1",
        "H4",
        "D1",
        "W1"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "Candle": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9]{2,19}$",
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/schemas/Timeframe"
        },
        "open_time": {
          "format": "date-time",
          "title": "Open Time",
          "type": "string"
        },
        "open": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Open",
          "type": "string"
        },
        "high": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "High",
          "type": "string"
        },
        "low": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Low",
          "type": "string"
        },
        "close": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Close",
          "type": "string"
        },
        "volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,21}0*$)\\d{0,15}\\.\\d{0,5}0*$)",
          "title": "Volume",
          "type": "string"
        },
        "bid_close": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Bid Close",
          "type": "string"
        },
        "ask_close": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ask Close"
        },
        "source": {
          "pattern": "^(simulated|mt5_(demo|live)_[a-z0-9_]{1,16})$",
          "title": "Source",
          "type": "string"
        },
        "is_closed": {
          "title": "Is Closed",
          "type": "boolean"
        }
      },
      "required": [
        "symbol",
        "timeframe",
        "open_time",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "bid_close",
        "ask_close",
        "source",
        "is_closed"
      ],
      "title": "Candle",
      "type": "object"
    },
    "CandlePage": {
      "additionalProperties": false,
      "properties": {
        "candles": {
          "items": {
            "$ref": "#/schemas/Candle"
          },
          "title": "Candles",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "candles",
        "next_cursor"
      ],
      "title": "CandlePage",
      "type": "object"
    },
    "MarketDataStatus": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "pattern": "^(simulated|mt5_(demo|live)_[a-z0-9_]{1,16})$",
          "title": "Source",
          "type": "string"
        },
        "mode": {
          "enum": [
            "SIMULATED",
            "DEMO",
            "LIVE",
            "UNCONFIRMED"
          ],
          "title": "Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "CONNECTING",
            "CONNECTED",
            "STALE",
            "DISCONNECTED",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "last_quote": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Quote"
        },
        "server_time": {
          "format": "date-time",
          "title": "Server Time",
          "type": "string"
        },
        "stale_after_seconds": {
          "title": "Stale After Seconds",
          "type": "integer"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "subscriptions": {
          "title": "Subscriptions",
          "type": "integer"
        },
        "history_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/schemas/Timeframe"
          },
          "title": "History Counts",
          "type": "object"
        },
        "history_complete": {
          "default": false,
          "title": "History Complete",
          "type": "boolean"
        },
        "digits": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digits"
        },
        "tick_size": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick Size"
        },
        "provider_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Symbol"
        },
        "market_state": {
          "default": "UNKNOWN",
          "enum": [
            "OPEN",
            "CLOSED",
            "UNKNOWN"
          ],
          "title": "Market State",
          "type": "string"
        },
        "last_candle": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Candle"
        },
        "volume_kind": {
          "default": "synthetic",
          "enum": [
            "synthetic",
            "tick_count"
          ],
          "title": "Volume Kind",
          "type": "string"
        }
      },
      "required": [
        "source",
        "mode",
        "status",
        "last_quote",
        "server_time",
        "stale_after_seconds",
        "detail",
        "subscriptions"
      ],
      "title": "MarketDataStatus",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9]{2,19}$",
          "title": "Symbol",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "bid": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Bid",
          "type": "string"
        },
        "ask": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Ask",
          "type": "string"
        },
        "volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,21}0*$)\\d{0,15}\\.\\d{0,5}0*$)",
          "title": "Volume",
          "type": "string"
        },
        "source": {
          "pattern": "^(simulated|mt5_(demo|live)_[a-z0-9_]{1,16})$",
          "title": "Source",
          "type": "string"
        },
        "mode": {
          "default": "SIMULATED",
          "enum": [
            "SIMULATED",
            "DEMO",
            "LIVE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "spread": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,21}0*$)\\d{0,15}\\.\\d{0,5}0*$)",
          "title": "Spread",
          "type": "string"
        },
        "status": {
          "enum": [
            "CONNECTED",
            "STALE",
            "DISCONNECTED",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "timestamp",
        "bid",
        "ask",
        "volume",
        "source",
        "spread",
        "status"
      ],
      "title": "Quote",
      "type": "object"
    },
    "MarketMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "snapshot",
            "update",
            "status",
            "heartbeat",
            "error"
          ],
          "title": "Type",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9]{2,19}$",
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/schemas/Timeframe"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/schemas/Quote"
            },
            {
              "type": "null"
            }
          ]
        },
        "candles": {
          "items": {
            "$ref": "#/schemas/Candle"
          },
          "title": "Candles",
          "type": "array"
        },
        "status": {
          "$ref": "#/schemas/MarketDataStatus"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "type",
        "symbol",
        "timeframe",
        "sequence",
        "quote",
        "candles",
        "status",
        "error"
      ],
      "title": "MarketMessage",
      "type": "object"
    },
    "SymbolInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Z][A-Z0-9]{2,19}$",
          "title": "Name",
          "type": "string"
        },
        "asset_class": {
          "default": "METAL",
          "maxLength": 30,
          "minLength": 1,
          "title": "Asset Class",
          "type": "string"
        },
        "digits": {
          "default": 2,
          "maximum": 5,
          "minimum": 0,
          "title": "Digits",
          "type": "integer"
        },
        "contract_size": {
          "default": "100",
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Contract Size",
          "type": "string"
        },
        "tick_value": {
          "default": "1",
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,19}0*$)\\d{0,13}\\.\\d{0,5}0*$)",
          "title": "Tick Value",
          "type": "string"
        },
        "default_spread": {
          "default": "0.30",
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,15}|(?=[\\d.]{1,21}0*$)\\d{0,15}\\.\\d{0,5}0*$)",
          "title": "Default Spread",
          "type": "string"
        },
        "session_hours": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Session Hours",
          "type": "object"
        },
        "is_active": {
          "title": "Is Active",
          "type": "boolean"
        },
        "source_available": {
          "title": "Source Available",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "is_active",
        "source_available"
      ],
      "title": "SymbolInfo",
      "type": "object"
    },
    "WsAuth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "auth",
          "title": "Type",
          "type": "string"
        },
        "token": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "type",
        "token"
      ],
      "title": "WsAuth",
      "type": "object"
    },
    "WsCommand": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "subscribe",
            "unsubscribe",
            "ping"
          ],
          "title": "Type",
          "type": "string"
        },
        "symbol": {
          "default": "XAUUSD",
          "pattern": "^[A-Z][A-Z0-9]{2,19}$",
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/schemas/Timeframe",
          "default": "M5"
        }
      },
      "required": [
        "type"
      ],
      "title": "WsCommand",
      "type": "object"
    }
  },
  "timeframes": [
    "M1",
    "M3",
    "M5",
    "M15",
    "M30",
    "H1",
    "H4",
    "D1",
    "W1"
  ]
}
