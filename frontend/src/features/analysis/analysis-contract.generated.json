        "symbol",
        "timeframe",
        "source",
        "algorithm_version",
        "config_id",
        "input_id",
        "window_start",
        "history",
        "as_of",
        "modules",
        "internal_state",
        "external_state",
        "swings",
        "events",
        "liquidity",
        "zones",
        "dealing_range",
        "indicators",
        "sessions",
        "current_sessions",
        "regime",
        "confluence_counts",
        "generated_at",
        "served_at",
        "cache_age_seconds"
      ],
      "title": "AnalysisResponse",
      "type": "object"
    },
    "ContextRow": {
      "additionalProperties": false,
      "properties": {
        "timeframe": {
          "$ref": "#/schemas/Timeframe"
        },
        "state": {
          "enum": [
            "BULLISH",
            "BEARISH",
            "NEUTRAL",
            "UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        },
        "history": {
          "$ref": "#/schemas/History"
        },
        "status": {
          "enum": [
            "READY",
            "PARTIAL_HISTORY",
            "INSUFFICIENT_DATA",
            "NO_STRUCTURE",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        }
      },
      "required": [
        "timeframe",
        "state",
        "history",
        "status",
        "as_of"
      ],
      "title": "ContextRow",
      "type": "object"
    },
    "MultiTimeframeContext": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "pattern": "^[A-Z][A-Z0-9]{2,19}$",
          "title": "Symbol",
          "type": "string"
        },
        "source": {
          "pattern": "^(simulated|mt5_(demo|live)_[a-z0-9_]{1,16})$",
          "title": "Source",
          "type": "string"
        },
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "bias": {
          "enum": [
            "BULLISH",
            "BEARISH",
            "NEUTRAL",
            "MIXED",
            "UNKNOWN"
          ],
          "title": "Bias",
          "type": "string"
        },
        "timeframes": {
          "items": {
            "$ref": "#/schemas/ContextRow"
          },
          "maxItems": 9,
          "title": "Timeframes",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "source",
        "algorithm_version",
        "bias",
        "timeframes"
      ],
      "title": "MultiTimeframeContext",
      "type": "object"
    }
  }
}
