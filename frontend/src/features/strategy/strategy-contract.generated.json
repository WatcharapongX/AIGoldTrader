{
  "schemas": {
    "EconomicEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider_event_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider Event Id",
          "type": "string"
        },
        "occurrence_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Occurrence Key",
          "type": "string"
        },
        "event_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Event Name",
          "type": "string"
        },
        "event_code": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Event Code",
          "type": "string"
        },
        "group_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "category": {
          "enum": [
            "EMPLOYMENT",
            "INFLATION",
            "CENTRAL_BANK",
            "GROWTH",
            "CONSUMER",
            "MANUFACTURING",
            "SERVICES",
            "HOUSING",
            "LABOR",
            "OTHER"
          ],
          "title": "Category",
          "type": "string"
        },
        "impact": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "HOLIDAY",
            "NON_ECONOMIC",
            "UNKNOWN"
          ],
          "title": "Impact",
          "type": "string"
        },
        "scheduled_at": {
          "format": "date-time",
          "title": "Scheduled At",
          "type": "string"
        },
        "actual": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "forecast": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Forecast"
        },
        "previous": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous"
        },
        "revised_previous": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revised Previous"
        },
        "previous_before_revision": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Before Revision"
        },
        "unit": {
          "enum": [
            "PERCENT",
            "THOUSANDS",
            "INDEX",
            "RATE",
            "NUMBER",
            "NON_NUMERIC"
          ],
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "SCHEDULED",
            "UPCOMING",
            "RELEASED",
            "REVISED",
            "CANCELLED",
            "DELAYED",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Source",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "FIXTURE",
            "LIVE",
            "UNAVAILABLE"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "released_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released At"
        },
        "revision_version": {
          "minimum": 1,
          "title": "Revision Version",
          "type": "integer"
        },
        "direction_rule": {
          "default": "CONTEXT_DEPENDENT",
          "enum": [
            "HIGHER_IS_POSITIVE",
            "LOWER_IS_POSITIVE",
            "CONTEXT_DEPENDENT"
          ],
          "title": "Direction Rule",
          "type": "string"
        },
        "field_provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Field Provenance",
          "type": "object"
        },
        "field_conflicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Field Conflicts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "provider_event_id",
        "occurrence_key",
        "event_name",
        "event_code",
        "group_id",
        "country",
        "currency",
        "category",
        "impact",
        "scheduled_at",
        "actual",
        "forecast",
        "previous",
        "unit",
        "status",
        "source",
        "source_mode",
        "updated_at",
        "available_at",
        "revision_version"
      ],
      "title": "EconomicEvent",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "identity_version": {
          "default": "legacy-aggregate-v1",
          "title": "Identity Version",
          "type": "string"
        },
        "scope": {
          "default": "LEGACY",
          "enum": [
            "LEGACY",
            "REQUEST",
            "STRATEGY",
            "EMPTY"
          ],
          "title": "Scope",
          "type": "string"
        },
        "component_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "object"
        },
        "context": {
          "$ref": "#/schemas/StrategyMarketContext"
        },
        "profiles": {
          "items": {
            "$ref": "#/schemas/TraderProfile"
          },
          "title": "Profiles",
          "type": "array"
        },
        "strategies": {
          "items": {
            "$ref": "#/schemas/StrategyDefinition"
          },
          "title": "Strategies",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/schemas/SetupCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "modes": {
          "default": [
            "SINGLE_STRATEGY",
            "MULTI_STRATEGY",
            "MULTI_TRADER"
          ],
          "items": {
            "type": "string"
          },
          "title": "Modes",
          "type": "array"
        },
        "adaptive_status": {
          "const": "RESERVED_DISABLED",
          "default": "RESERVED_DISABLED",
          "title": "Adaptive Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "context",
        "profiles",
        "strategies",
        "candidates"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "description_th": {
          "title": "Description Th",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "weight": {
          "default": 0,
          "maximum": 100,
          "minimum": -100,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "description_th"
      ],
      "title": "Evidence",
      "type": "object"
    },
