{
  "schemas": {
    "EconomicEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider_event_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider Event Id",
          "type": "string"
        },
        "occurrence_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Occurrence Key",
          "type": "string"
        },
        "event_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Event Name",
          "type": "string"
        },
        "event_code": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Event Code",
          "type": "string"
        },
        "group_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "category": {
          "enum": [
            "EMPLOYMENT",
            "INFLATION",
            "CENTRAL_BANK",
            "GROWTH",
            "CONSUMER",
            "MANUFACTURING",
            "SERVICES",
            "HOUSING",
            "LABOR",
            "OTHER"
          ],
          "title": "Category",
          "type": "string"
        },
        "impact": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "HOLIDAY",
            "NON_ECONOMIC",
            "UNKNOWN"
          ],
          "title": "Impact",
          "type": "string"
        },
        "scheduled_at": {
          "format": "date-time",
          "title": "Scheduled At",
          "type": "string"
        },
        "actual": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "forecast": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Forecast"
        },
        "previous": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous"
        },
        "revised_previous": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revised Previous"
        },
        "previous_before_revision": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Before Revision"
        },
        "unit": {
          "enum": [
            "PERCENT",
            "THOUSANDS",
            "INDEX",
            "RATE",
            "NUMBER",
            "NON_NUMERIC"
          ],
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "SCHEDULED",
            "UPCOMING",
            "RELEASED",
            "REVISED",
            "CANCELLED",
            "DELAYED",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Source",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "FIXTURE",
            "LIVE",
            "UNAVAILABLE"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "released_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released At"
        },
        "revision_version": {
          "minimum": 1,
          "title": "Revision Version",
          "type": "integer"
        },
        "direction_rule": {
          "default": "CONTEXT_DEPENDENT",
          "enum": [
            "HIGHER_IS_POSITIVE",
            "LOWER_IS_POSITIVE",
            "CONTEXT_DEPENDENT"
          ],
          "title": "Direction Rule",
          "type": "string"
        },
        "field_provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Field Provenance",
          "type": "object"
        },
        "field_conflicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Field Conflicts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "provider_event_id",
        "occurrence_key",
        "event_name",
        "event_code",
        "group_id",
        "country",
        "currency",
        "category",
        "impact",
        "scheduled_at",
        "actual",
        "forecast",
        "previous",
        "unit",
        "status",
        "source",
        "source_mode",
        "updated_at",
        "available_at",
        "revision_version"
      ],
      "title": "EconomicEvent",
      "type": "object"
    },
    "CalendarPage": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/schemas/EconomicEvent"
          },
          "maxItems": 200,
          "title": "Events",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "FIXTURE",
            "LIVE",
            "UNAVAILABLE"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "state": {
          "enum": [
            "AVAILABLE",
            "CALENDAR_UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "source",
        "source_mode",
        "state",
        "as_of",
        "generated_at",
        "truncated"
      ],
      "title": "CalendarPage",
      "type": "object"
    },
    "EventDetail": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/schemas/EconomicEvent"
        },
        "revisions": {
          "items": {
            "$ref": "#/schemas/EconomicEvent"
          },
          "maxItems": 100,
          "title": "Revisions",
          "type": "array"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        }
      },
      "required": [
        "event",
        "revisions",
        "as_of"
      ],
      "title": "EventDetail",
      "type": "object"
    },
    "EventRelevance": {
      "additionalProperties": false,
      "properties": {
        "affected_currency": {
          "title": "Affected Currency",
          "type": "string"
        },
        "score": {
          "maximum": 3,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "channels": {
          "items": {
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        }
      },
      "required": [
        "affected_currency",
        "score",
        "channels"
      ],
      "title": "EventRelevance",
      "type": "object"
    },
    "ReactionWindow": {
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "title": "Seconds",
          "type": "integer"
        },
        "status": {
          "enum": [
            "READY",
            "WAITING",
            "REACTION_UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "cutoff": {
          "format": "date-time",
          "title": "Cutoff",
          "type": "string"
        },
        "price_before": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Before"
        },
        "price_after": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price After"
        },
        "return_percent": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Percent"
        },
        "move_atr": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Move Atr"
        },
        "range_atr": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Atr"
        },
        "tick_activity_ratio": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick Activity Ratio"
        },
        "classification": {
          "default": "UNCONFIRMED",
          "enum": [
            "STRONG_DIRECTIONAL",
            "WHIPSAW",
            "LIQUIDITY_SWEEP_REVERSAL",
            "BREAKOUT",
            "FAILED_BREAKOUT",
            "MUTED",
            "UNCONFIRMED"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "seconds",
        "status",
        "cutoff"
      ],
      "title": "ReactionWindow",
      "type": "object"
    },
    "ReleaseGroup": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "alignment": {
          "enum": [
            "ALL_ALIGNED",
            "MOSTLY_ALIGNED",
            "MIXED",
            "CONFLICTING",
            "UNAVAILABLE"
          ],
          "title": "Alignment",
          "type": "string"
        },
        "bias": {
          "enum": [
            "USD_STRONG_POSITIVE",
            "USD_POSITIVE",
            "USD_NEUTRAL",
            "USD_NEGATIVE",
            "USD_STRONG_NEGATIVE",
            "CONFLICTING",
            "UNKNOWN"
          ],
          "title": "Bias",
          "type": "string"
        },
        "score": {
          "pattern": "^-?\\d+(?:\\.\\d+)?$",
          "title": "Score",
          "type": "string"
        },
        "completeness": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "surprises": {
          "items": {
            "$ref": "#/schemas/Surprise"
          },
          "title": "Surprises",
          "type": "array"
        }
      },
      "required": [
        "group_id",
        "event_ids",
        "alignment",
        "bias",
        "score",
        "completeness",
        "surprises"
      ],
      "title": "ReleaseGroup",
      "type": "object"
    },
    "StructureContext": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ALIGNED",
            "CONFLICTING",
            "WAITING",
            "STRUCTURE_UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "upstream_input_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Input Id"
        },
        "upstream_config_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Config Id"
        },
        "upstream_algorithm_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Algorithm Version"
        },
        "upstream_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream As Of"
        },
        "upstream_window_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Window Start"
        },
        "absence_means": {
          "const": "NOT_INCLUDED_UNKNOWN",
          "default": "NOT_INCLUDED_UNKNOWN",
          "title": "Absence Means",
          "type": "string"
        },
        "references": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "References",
          "type": "object"
        }
      },
      "required": [
        "status",
        "upstream_input_id",
        "upstream_config_id",
        "upstream_algorithm_version",
        "upstream_as_of",
        "upstream_window_start",
        "references"
      ],
      "title": "StructureContext",
      "type": "object"
    },
    "Surprise": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "raw": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "relative": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative"
        },
        "normalized": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized"
        },
        "normalized_method": {
          "const": "UNAVAILABLE_NO_DISTRIBUTION",
          "default": "UNAVAILABLE_NO_DISTRIBUTION",
          "title": "Normalized Method",
          "type": "string"
        },
        "direction": {
          "enum": [
            "ABOVE",
            "BELOW",
            "INLINE",
            "UNAVAILABLE"
          ],
          "title": "Direction",
          "type": "string"
        },
        "magnitude": {
          "enum": [
            "LARGE",
            "SMALL",
            "ZERO",
            "UNAVAILABLE"
          ],
          "title": "Magnitude",
          "type": "string"
        },
        "usd_direction": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "NEUTRAL",
            "UNKNOWN"
          ],
          "title": "Usd Direction",
          "type": "string"
        },
        "revision_delta": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision Delta"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "raw",
        "relative",
        "direction",
        "magnitude",
        "usd_direction",
        "revision_delta",
        "reason_code"
      ],
      "title": "Surprise",
      "type": "object"
    },
